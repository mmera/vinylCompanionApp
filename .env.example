# Copy this file to `.env` and fill it in. `.env` is gitignored.
# Only variables prefixed with EXPO_PUBLIC_ are visible to app code.

# Spotify: the app's PUBLIC client ID. Under Authorization Code + PKCE this is
# an identifier, not a secret — it is meant to ship in the bundle. There is no
# client secret any more; users sign in with their own Spotify account.
# From https://developer.spotify.com/dashboard -> your app -> Settings
# Read at BUILD time, not runtime: setting it after a build has no effect on
# that build. If it is missing, the app lets you paste the client ID in
# Settings instead.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional, for `npm run smoke-test` only. Which redirect URI to check against
# the dashboard registration. Defaults to the native scheme.
# SPOTIFY_REDIRECT_URI=https://<user>.github.io/vinylCompanionApp/

# Optional, local development only. Pre-fills the Claude key in Settings so you
# don't retype it. Never set in CI — the web build refuses to publish a bundle
# containing a key.
# From https://platform.claude.com/settings/keys
EXPO_PUBLIC_CLAUDE_API_KEY=

# Optional: override the vision model.
# EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-5
