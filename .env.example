# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored — never commit real keys.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to app code.
# See the README for where to get each of these.

# https://platform.claude.com/settings/keys
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# https://developer.spotify.com/dashboard -> your app -> Settings
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the vision model used by the scanner.
# EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-5
