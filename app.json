{
  "expo": {
    "name": "Crate",
    "slug": "crate",
    "scheme": "crate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crate.vinyl",
      "infoPlist": {
        "NSCameraUsageDescription": "Crate uses the camera to identify album covers you point it at.",
        "LSApplicationQueriesSchemes": ["spotify"]
      }
    },
    "android": {
      "package": "com.crate.vinyl",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Crate uses the camera to identify album covers you point it at."
        }
      ]
    ]
  }
}
